# ============================================
# InvestIA - Configurações
# ============================================

# Google Gemini API Key (obrigatório)
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_aqui

# JWT Secret (obrigatório em produção)
# Use uma string aleatória de 32+ caracteres
# Exemplo: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=mude-esta-secret-em-producao

# CORS Origins (separado por vírgula)
# Em produção, inclua a URL do frontend
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# ============================================
# Frontend
# ============================================

# URL do backend (obrigatório para o frontend)
# Local: http://localhost:8000
# Railway: https://investia-backend.up.railway.app
# API_URL=http://localhost:8000

# ============================================
# Banco de dados
# ============================================

# SQLite padrão (local)
# DATABASE_URL=sqlite:///./investia.db

# Railway (usar com Volume montado em /data)
# DATABASE_URL=sqlite:////data/investia.db

# ============================================
# Gemini (opcionais)
# ============================================

# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash:generateContent
# GEMINI_TIMEOUT=90
# GEMINI_RETRIES=2
# GEMINI_RETRY_DELAY=1.0
# GEMINI_MAX_CONTEXT_LENGTH=60000

# ============================================
# Auth (opcionais)
# ============================================

# ACCESS_TOKEN_EXPIRE_MINUTES=120
# REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# Deploy
# ============================================

# Railway define $PORT automaticamente.
# Não é necessário definir manualmente.
