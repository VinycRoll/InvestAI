# ============================================
# InvestIA - Configurações
# ============================================

# Google Gemini API Key (obrigatório)
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_aqui

# JWT Secret (obrigatório em produção)
# Use uma string aleatória de 32+ caracteres
# Exemplo: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=mude-esta-secret-em-producao

# CORS Origins (separado por vírgula)
# Em produção, coloque seu domínio
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# ============================================
# Deploy (opcional)
# ============================================

# Railway/Heroku
# PORT=8000

# Banco de dados (SQLite padrão)
# DATABASE_URL=sqlite:///./investia.db

# ============================================
# Docker
# ============================================

# Para usar docker-compose:
# docker-compose up -d
